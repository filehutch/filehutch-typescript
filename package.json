{
  "name": "@filehutch/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for FileHutch. Your app persists an opaque file id; FileHutch owns uploads, delivery and transforms.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "filehutch",
    "file-upload",
    "s3",
    "r2",
    "storage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filehutch/filehutch-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/filehutch/filehutch-typescript/issues"
  },
  "homepage": "https://github.com/filehutch/filehutch-typescript#readme"
}
